<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Share files from app-specific directory -->
    <files-path
        name="pdf_documents"
        path="pdf_documents/" />

    <!-- Share files from cache directory -->
    <cache-path
        name="cache"
        path="/" />

    <!-- Share files from external files directory -->
    <external-files-path
        name="external_files"
        path="/" />

    <!-- Share all external storage (for Android 11+ with MANAGE_EXTERNAL_STORAGE) -->
    <external-path
        name="external_storage"
        path="/" />
</paths>

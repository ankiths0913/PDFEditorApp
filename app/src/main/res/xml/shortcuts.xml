<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="scan_doc"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_scan"
        android:shortcutLongLabel="@string/shortcut_scan">
        <intent
            android:action="com.ankit.pdfeditor.ACTION_SCAN"
            android:targetPackage="com.ankit.pdfeditor"
            android:targetClass="com.ankit.pdfeditor.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="merge_pdf"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_merge"
        android:shortcutLongLabel="@string/shortcut_merge">
        <intent
            android:action="com.ankit.pdfeditor.ACTION_MERGE"
            android:targetPackage="com.ankit.pdfeditor"
            android:targetClass="com.ankit.pdfeditor.MainActivity" />
    </shortcut>
</shortcuts>
